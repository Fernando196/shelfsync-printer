PORT=4100
# Puerto COM saliente de la MP210 emparejada por Bluetooth (npm run ports para verlos)
PRINTER_PORT=COM5
PRINTER_BAUD_RATE=9600
# true = no manda nada a la impresora, solo loguea (para probar sin la MP210)
PRINTER_DRY_RUN=false
# El mismo JWT_SECRET de shelfsync-api: solo imprime quien tiene sesion en la app
JWT_SECRET=
# Origenes web permitidos, separados por coma
CORS_ORIGINS=https://app-inv.fernandomorales.dev,http://localhost:8081
